<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Только Windows 11 (22000+) -->
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>GameLauncher.App</RootNamespace>
    <AssemblyName>GameLauncher</AssemblyName>
    <Version>1.2.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\GameLauncher.ico</ApplicationIcon>

    <!-- Сведения о файле (Свойства → Подробно). Издателя в SmartScreen/UAC они не задают — это делает только подпись. -->
    <Product>GameLauncher</Product>
    <!-- AssemblyTitle → «Описание файла»: так процесс называется в диспетчере задач -->
    <AssemblyTitle>GameLauncher</AssemblyTitle>
    <Description>Лаунчер игр для Windows 11</Description>
    <Authors>eva3si0n</Authors>
    <Company>eva3si0n</Company>
    <Copyright>© 2026 eva3si0n</Copyright>
    <!-- Без «+хеш коммита» в «Версии продукта» -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <UseWinUI>true</UseWinUI>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Своя точка входа (Program.cs): лаунчер работает в одном экземпляре -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Первая версия: только x64 -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <!-- Unpackaged + self-contained: папка с exe, ничего не нужно ставить -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Нужно и без MSIX: подключает генерацию и копирование .pri с ресурсами XAML (как в шаблоне WinUI 3) -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!-- Локализации: только русский и английский (английский — запасной язык WinUI) -->
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <!-- Иконка окна (панель задач, Alt+Tab) и строки заголовка грузятся из файлов рядом с exe -->
    <Content Include="Assets\GameLauncher.ico;Assets\TitleBarIcon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameLauncher.Core\GameLauncher.Core.csproj" />
  </ItemGroup>

  <!--
    Windows App SDK кладёт переводы встроенных строк WinUI (.mui) для 87 языков — по папке на язык.
    Оставляем только ru-RU и en-us. На то, какие символы приложение показывает и принимает, это не влияет:
    кириллица и латиница работают при любом наборе .mui.
  -->
  <Target Name="KeepOnlyRuEnWinUIResources" AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents">
    <ItemGroup>
      <_UnneededWinUIMui Include="@(None)"
          Condition="'%(None.Extension)' == '.mui'
                     and !$([System.String]::Copy('%(None.Link)').ToLowerInvariant().StartsWith('ru-ru'))
                     and !$([System.String]::Copy('%(None.Link)').ToLowerInvariant().StartsWith('en-us'))" />
      <None Remove="@(_UnneededWinUIMui)" />
    </ItemGroup>
  </Target>

</Project>
