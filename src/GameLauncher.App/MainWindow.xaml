<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GameLauncher.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GameLauncher.App.ViewModels"
    Title="GameLauncher">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Своя строка заголовка: контент продлён под неё, кнопки окна рисует система -->
    <Grid x:Name="AppTitleBar" Height="48">
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
            <FontIcon FontSize="16" Glyph="&#xE7FC;" />
            <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="GameLauncher" />
        </StackPanel>
    </Grid>

    <Grid x:Name="ContentRoot" Grid.Row="1" Padding="24,8,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16" Visibility="{x:Bind ViewModel.IsLibraryVisible, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Библиотека" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <AutoSuggestBox
                x:Name="SearchBox"
                AutomationProperties.Name="Поиск по библиотеке"
                Width="280"
                PlaceholderText="Поиск (Ctrl+F)"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <AutoSuggestBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F" Invoked="OnSearchAccelerator" Modifiers="Control" />
                </AutoSuggestBox.KeyboardAccelerators>
            </AutoSuggestBox>
            <Button AutomationProperties.Name="Настройки" Command="{x:Bind ViewModel.OpenSettingsCommand}" ToolTipService.ToolTip="Настройки">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
            <Button
                Command="{x:Bind ViewModel.AddGameCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="Добавить игру" />
                </StackPanel>
            </Button>
            </StackPanel>
        </Grid>

        <GridView
            Grid.Row="1"
            Padding="0,0,0,24"
            IsItemClickEnabled="True"
            ItemClick="OnGameClick"
            ItemsSource="{x:Bind ViewModel.VisibleGames}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.IsLibraryVisible, Mode=OneWay}">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:GameItemViewModel">
                    <Grid
                        Width="176"
                        AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ToolTipService.ToolTip="{x:Bind ExePath}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="264" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Command="{x:Bind FindCoverCommand}" Text="Найти обложку…">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Pictures" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind RemoveCoverCommand}" Text="Убрать обложку" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Command="{x:Bind RenameCommand}" Text="Переименовать">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Rename" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind DeleteCommand}" Text="Удалить из библиотеки">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Delete" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <!-- Обложка 2:3; без неё — иконка exe; без иконки — значок-заглушка -->
                        <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8,8,0,0">
                            <Image
                                Source="{x:Bind Cover, Mode=OneWay}"
                                Stretch="UniformToFill"
                                Visibility="{x:Bind HasCover, Mode=OneWay}" />
                            <Image
                                Width="72"
                                Height="72"
                                Source="{x:Bind Icon, Mode=OneWay}"
                                Visibility="{x:Bind ShowIcon, Mode=OneWay}" />
                            <FontIcon
                                FontSize="56"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE7FC;"
                                Visibility="{x:Bind ShowPlaceholder, Mode=OneWay}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Padding="12,8,12,12">
                            <TextBlock
                                MaxLines="2"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind PlayTimeText, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind StatusText, Mode=OneWay}"
                                Visibility="{x:Bind HasStatus, Mode=OneWay}" />
                            <Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind PlayCommand}"
                                Content="Играть"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsEmptyLibraryVisible, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Библиотека пуста" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Нажмите «Добавить игру» и выберите .exe" />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Ничего не найдено"
            Visibility="{x:Bind ViewModel.IsNoSearchResultsVisible, Mode=OneWay}" />

        <!-- Страница игры: открывается кликом по карточке -->
        <ScrollViewer
            Grid.RowSpan="2"
            Margin="-24,-8,-24,0"
            Visibility="{x:Bind ViewModel.IsDetailsOpen, Mode=OneWay}">
            <StackPanel Padding="0,0,0,24">
                <Grid Height="300">
                    <Image
                        Source="{x:Bind ViewModel.SelectedGame.Hero, Mode=OneWay}"
                        Stretch="UniformToFill"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.SelectedGame.HasHero, Mode=OneWay, FallbackValue=Collapsed}" />
                    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" Visibility="{x:Bind ViewModel.SelectedGame.HasNoHero, Mode=OneWay, FallbackValue=Collapsed}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Баннера нет — он скачивается вместе с обложкой («Найти обложку…»)" />
                    </Grid>
                    <!-- Кнопка «Назад» поверх баннера; Esc работает, только пока страница открыта -->
                    <Button
                        Margin="16"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Назад"
                        Command="{x:Bind ViewModel.CloseDetailsCommand}"
                        ToolTipService.ToolTip="Назад (Esc)">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Escape" />
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72B;" />
                            <TextBlock Text="Назад" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Padding="24,20,24,0" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            Style="{StaticResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedGame.Name, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="{x:Bind ViewModel.SelectedGame.StatusText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.SelectedGame.HasStatus, Mode=OneWay, FallbackValue=Collapsed}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        MinWidth="160"
                        VerticalAlignment="Top"
                        Command="{x:Bind ViewModel.SelectedGame.PlayCommand, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE768;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Играть" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Margin="24,24,24,0" ColumnSpacing="48" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Сыграно" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedGame.PlayTimeText, Mode=OneWay}" />
                    <TextBlock Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Последний запуск" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedGame.LastPlayedText, Mode=OneWay}" />
                    <TextBlock Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Добавлена" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedGame.AddedText, Mode=OneWay}" />
                    <TextBlock Grid.Row="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Файл" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.SelectedGame.ExePath, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Grid>

                <!-- Описание из Steam -->
                <StackPanel
                    Margin="24,32,24,0"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.SelectedGame.HasDetails, Mode=OneWay, FallbackValue=Collapsed}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Об игре" />
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.SelectedGame.ShortDescription, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="48" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Жанры" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedGame.GenresText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Разработчик" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedGame.DevelopersText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Издатель" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedGame.PublishersText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Дата выхода" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedGame.SteamReleaseDate, Mode=OneWay}" />
                    </Grid>

                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="OnScreenshotClick"
                        ItemsSource="{x:Bind ViewModel.SelectedGame.Screenshots, Mode=OneWay}"
                        SelectionMode="None"
                        Visibility="{x:Bind ViewModel.SelectedGame.HasScreenshots, Mode=OneWay, FallbackValue=Collapsed}">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScreenshotViewModel">
                                <Border
                                    Width="240"
                                    AutomationProperties.Name="Скриншот"
                                    Height="135"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="4">
                                    <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Header="Подробнее"
                        Visibility="{x:Bind ViewModel.SelectedGame.HasAbout, Mode=OneWay, FallbackValue=Collapsed}">
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.SelectedGame.About, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Expander>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.SelectedGame.DetailsSourceText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    Margin="24,32,24,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Описания нет. Нажмите «Найти описание в Steam…» — или найдите обложку: описание подтянется вместе с ней, если игра есть в Steam."
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.SelectedGame.HasNoDetails, Mode=OneWay, FallbackValue=Collapsed}" />

                <StackPanel Margin="24,24,24,0" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.SelectedGame.FindDetailsCommand, Mode=OneWay}" Content="Найти описание в Steam…" />
                    <Button Command="{x:Bind ViewModel.SelectedGame.RefreshDetailsCommand, Mode=OneWay}" Content="Обновить описание" />
                </StackPanel>

                <StackPanel Margin="24,8,24,0" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.SelectedGame.OpenFolderCommand, Mode=OneWay}" Content="Открыть папку" />
                    <Button Command="{x:Bind ViewModel.SelectedGame.FindCoverCommand, Mode=OneWay}" Content="Найти обложку…" />
                    <Button Command="{x:Bind ViewModel.SelectedGame.RemoveCoverCommand, Mode=OneWay}" Content="Убрать обложку" />
                    <Button Command="{x:Bind ViewModel.SelectedGame.RenameCommand, Mode=OneWay}" Content="Переименовать" />
                    <Button Command="{x:Bind ViewModel.SelectedGame.DeleteCommand, Mode=OneWay}" Content="Удалить из библиотеки" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Настройки -->
        <ScrollViewer
            Grid.RowSpan="2"
            Visibility="{x:Bind ViewModel.IsSettingsOpen, Mode=OneWay}">
            <StackPanel MaxWidth="860" Padding="0,8,0,24" HorizontalAlignment="Stretch" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button AutomationProperties.Name="Назад" Command="{x:Bind ViewModel.CloseSettingsCommand}" ToolTipService.ToolTip="Назад (Esc)">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Escape" />
                        </Button.KeyboardAccelerators>
                        <FontIcon FontSize="14" Glyph="&#xE72B;" />
                    </Button>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}" Text="Настройки" />
                </StackPanel>

                <StackPanel Style="{StaticResource SettingsCardStyle}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Внешний вид" />
                    <ComboBox MinWidth="240" Header="Тема" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Как в системе" />
                        <ComboBoxItem Content="Светлая" />
                        <ComboBoxItem Content="Тёмная" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Style="{StaticResource SettingsCardStyle}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Обложки: SteamGridDB" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.ApiKeyStatusText, Mode=OneWay}" TextWrapping="Wrap" />
                    <Button Command="{x:Bind ViewModel.EditApiKeyCommand}" Content="Изменить API-ключ…" />
                </StackPanel>

                <StackPanel Style="{StaticResource SettingsCardStyle}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Описания: Steam" />
                    <ComboBox
                        MinWidth="240"
                        Header="Основная витрина"
                        ItemsSource="{x:Bind ViewModel.SteamRegionNames}"
                        SelectedIndex="{x:Bind ViewModel.SteamRegionIndex, Mode=TwoWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Выберите регион своего Steam-аккаунта. Если игры нет на этой витрине, описание берётся с витрин США и России. Язык описаний — русский."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Style="{StaticResource SettingsCardStyle}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Данные" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Библиотека, время в играх, обложки, описания и настройки хранятся здесь:"
                        TextWrapping="Wrap" />
                    <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.DataDirectory}" TextWrapping="Wrap" />
                    <Button Command="{x:Bind ViewModel.OpenDataFolderCommand}" Content="Открыть папку данных" />
                </StackPanel>

                <StackPanel Style="{StaticResource SettingsCardStyle}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="О программе" />
                    <TextBlock>
                        <Run Text="GameLauncher" />
                        <Run Text="{x:Bind ViewModel.AppVersion}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Grid>
</Window>
